# Secrets — never commit
config/.env
config/*.local.*
*.key
*secret*

# Raw data exports / backups — real business & customer data, not for git history
/data/**
!/data/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# PowerShell transcripts
*.transcript

# Supabase local state. Migrations and edge functions ARE committed; the linked-project
# temp state and any local env file are not.
supabase/.branches
supabase/.temp
supabase/.env


# Dashboard workbooks - contain real call records, contact names and phone numbers
*.xlsx
