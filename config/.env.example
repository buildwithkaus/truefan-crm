# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.
LSQ_ACCESS_KEY=
LSQ_SECRET_KEY=
LSQ_API_HOST=https://api-in21.leadsquared.com/v2
# Async API - Capture/Update Leads and Opportunities as background jobs (submit, poll Status
# API for RequestId). Requires accessKey/secretKey AND this separate x-api-key header.
LSQ_ASYNC_API_HOST=https://asyncapi-in21.leadsquared.com
LSQ_ASYNC_API_KEY=

# --- Calling pipeline store (docs/CALLING_PIPELINE.md) ---
# Used by scripts/pipeline/backfill.ps1 and verify-against-oracle.ps1. The Apps Script
# project keeps its own copies in Script Properties; these are only for the local scripts.
#
# SERVICE key bypasses row level security. Never put it in the Excel workbook - Power Query
# stores keys in plaintext and that file gets shared. Use the anon key there
# (docs/EXCEL_DASHBOARD.md), which migration 004 limits to the aggregate views.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
